# ============================================================================
# Seer Platform - Environment Variables
# ============================================================================
# Copy this file to .env and fill in your actual values
# cp .env.example .env

# ============================================================================
# LangGraph API Configuration (Required for Railway/Production)
# ============================================================================

# Postgres connection string for checkpoints and thread persistence
# Format: postgresql://user:password@host:port/database
# For Railway: Use the DATABASE_URL provided by Railway Postgres plugin
# Example: postgresql://postgres:password@containers-us-west-xxx.railway.app:5432/seer
DATABASE_URL=

# Optional: Redis connection string for async tasks
# Format: redis://user:password@host:port/db
# REDIS_URI=

# ============================================================================
# LLM & AI Services (Required)
# ============================================================================

# OpenAI API key for LLM calls and embeddings
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ============================================================================
# Pinecone Vector Search (Optional - if using tool search)
# ============================================================================

# Pinecone API key for semantic tool search
# Get from: https://app.pinecone.io/
PINECONE_API_KEY=

# Pinecone index name for tool search
PINECONE_INDEX_NAME=

# ============================================================================
# Web Search & External APIs (Optional)
# ============================================================================

# Tavily API key for web search
# Get from: https://tavily.com/
TAVILY_API_KEY=

# GitHub token for sandbox provisioning and repo access
# Get from: https://github.com/settings/tokens
GITHUB_TOKEN=

# Context7 API key for MCP tools
# Get from: https://context7.com/
CONTEXT7_API_KEY=

# ============================================================================
# PostHog Analytics (Optional)
# ============================================================================

# PostHog project API key (from PostHog project settings)
# Get from your PostHog instance: Settings > Project > API Keys
POSTHOG_API_KEY=

# PostHog host URL (your Railway PostHog instance or PostHog Cloud)
# For Railway: https://posthog-abc123.railway.app
# For Cloud: https://app.posthog.com or https://eu.posthog.com
POSTHOG_HOST=

# Enable PostHog analytics tracking (set to true when configured)
POSTHOG_ENABLED=false

# ============================================================================
# Feature Flags
# ============================================================================

# Recursive Language Model (RLM) Tool
# Enables advanced multi-step reasoning and large context handling for workflow agent
# When enabled, the agent can decompose complex tasks recursively
# Default: false (disabled) - enable for testing/production after validation
# Based on: https://arxiv.org/html/2512.24601v1
ENABLE_RLM_TOOL=false
