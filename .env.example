# Seer Configuration Example
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ==============================================================================
# Environment Detection
# ==============================================================================

# Environment: dev, staging, or prod
# This determines which AWS Parameter Store path is used (if AWS is configured)
ENV=dev

# Deployment mode: 'self-hosted' or 'cloud'
SEER_MODE=self-hosted

# ==============================================================================
# Required Secrets for Core Functionality
# ==============================================================================

# OpenAI API Key (Required for LLM functionality)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here

# Anthropic API Key (Optional - for Claude models)
# Get from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# PostgreSQL Database URL (Required for LangGraph checkpointer)
# Format: postgresql://user:password@host:port/database
# For local development with Docker: postgresql://postgres:postgres@localhost:5432/seer
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/seer

# ==============================================================================
# Authentication Configuration (Optional)
# ==============================================================================

# Clerk Authentication (for multi-user deployments)
# Get from: https://dashboard.clerk.com/
# CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
# CLERK_ISSUER=https://your-app.clerk.accounts.dev
# CLERK_AUDIENCE=https://your-domain.com
# CLERK_SECRET_KEY=sk_test_your-secret-key

# Google OAuth (for integrations)
# Get from: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret

# GitHub OAuth (for integrations)
# Get from: https://github.com/settings/developers
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# Supabase Management API (for Supabase integrations)
# Get from: https://supabase.com/dashboard/account/tokens
# SUPABASE_CLIENT_ID=your-supabase-client-id
# SUPABASE_CLIENT_SECRET=your-supabase-client-secret

# ==============================================================================
# Feature Flags
# ==============================================================================

# Require human approval for PostgreSQL write operations (default: true)
POSTGRES_WRITE_REQUIRES_APPROVAL=true

# Enable workflow trigger polling (default: true)
TRIGGER_POLLER_ENABLED=true

# Default LLM model (default: gpt-4o-mini)
DEFAULT_LLM_MODEL=gpt-4o-mini

# Redis/Valkey connection string (default: redis://localhost:6379/0)
REDIS_URL=redis://localhost:6379/0

# Enable chat AI in self-hosted mode (-1 = unlimited, 0 = disabled)
# IMPORTANT: Chat is DISABLED by default in self-hosted mode for security
# Set to -1 to enable unlimited chat messages for development/testing
CHAT_MESSAGES_TOTAL_SELF_HOSTED=-1

# ==============================================================================
# Frontend Integration
# ==============================================================================

# Frontend URL (used for redirects)
# Default: https://app.getseer.dev (cloud frontend - works out of the box)
# For local development: http://localhost:5173 (local Vite dev server)
FRONTEND_URL=https://app.getseer.dev

# Backend URL passed to frontend (for ?backend= parameter)
# Default: localhost:8000
# Docker: Use localhost:8000 (host-accessible)
# Network access: Use your machine's IP like 192.168.1.100:8000
BACKEND_API_URL=localhost:8000

# Auto-open browser on startup in self-hosted mode (default: true)
AUTO_OPEN_BROWSER=true

# See documentation/docs/advanced/CONFIGURATION.md for complete list
