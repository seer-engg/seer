{
  "name": "Customer Support Email Automation",
  "description": "Monitor support inbox, classify emails with AI, route urgent issues to ticketing system, auto-respond to FAQs, create drafts for complex questions",
  "tags": ["gmail", "support", "automation", "ai", "supabase", "classification", "llm"],
  "customization_guide": "Update support email address in trigger query. Configure Supabase connection ID and table names (support_tickets, support_interactions). Adjust label names for your Gmail setup. Modify LLM classification criteria and auto-response templates. Set appropriate urgency thresholds and categories for your support workflow.",
  "spec": {
    "version": "2",
    "triggers": [
      {
        "id": "support_inbox_poll",
        "key": "poll.gmail.email_received",
        "title": "Support_Inbox_Monitor",
        "provider": "gmail",
        "mode": "polling",
        "enabled": true,
        "provider_config": {
          "label_ids": ["INBOX"],
          "query": "is:unread to:support@company.com",
          "max_results": 10,
          "overlap_ms": 300000
        }
      }
    ],
    "nodes": [
      {
        "id": "extract_email_id",
        "type": "task",
        "kind": "set",
        "value": "${trigger.data.id}",
        "out": "email_id"
      },
      {
        "id": "fetch_full_email",
        "type": "tool",
        "tool": "gmail_get_message",
        "in": {
          "message_id": "${email_id}"
        },
        "out": "full_email"
      },
      {
        "id": "classify_email",
        "type": "llm",
        "model": "gpt-5-mini",
        "temperature": 0.3,
        "prompt": "Analyze this support email and classify it:\n\nFrom: ${full_email.from.email}\nSubject: ${full_email.subject}\nBody: ${full_email.body}\n\nClassify by:\n1. Urgency (urgent/normal) - Is this a critical issue requiring immediate attention?\n2. Category (billing/technical/general/account) - What type of support request?\n3. Sentiment (positive/neutral/negative/frustrated) - Customer's emotional tone\n4. Auto-response capability (true/false) - Can this be answered with a standard FAQ response?\n\nProvide reasoning for urgency classification.",
        "out": "classification",
        "output": {
          "mode": "json",
          "schema": {
            "json_schema": {
              "type": "object",
              "properties": {
                "urgency": {
                  "type": "string",
                  "enum": ["urgent", "normal"]
                },
                "category": {
                  "type": "string",
                  "enum": ["billing", "technical", "general", "account"]
                },
                "sentiment": {
                  "type": "string",
                  "enum": ["positive", "neutral", "negative", "frustrated"]
                },
                "auto_response_capable": {
                  "type": "boolean"
                },
                "reasoning": {
                  "type": "string"
                }
              },
              "required": ["urgency", "category", "sentiment", "auto_response_capable", "reasoning"]
            }
          }
        }
      },
      {
        "id": "check_if_urgent",
        "type": "if",
        "condition": "${classification.urgency == 'urgent'}"
      },
      {
        "id": "create_urgent_ticket",
        "type": "tool",
        "tool": "supabase_table_insert",
        "in": {
          "integration_resource_id": 123,
          "table": "support_tickets",
          "record": {
            "email_id": "${email_id}",
            "thread_id": "${full_email.thread_id}",
            "customer_email": "${full_email.from.email}",
            "customer_name": "${full_email.from.name}",
            "subject": "${full_email.subject}",
            "category": "${classification.category}",
            "sentiment": "${classification.sentiment}",
            "urgency": "urgent",
            "status": "open",
            "priority": "high",
            "body": "${full_email.body}",
            "classification_reasoning": "${classification.reasoning}"
          }
        },
        "out": "urgent_ticket"
      },
      {
        "id": "create_urgent_draft",
        "type": "tool",
        "tool": "gmail_create_draft",
        "in": {
          "to": ["${full_email.from.email}"],
          "subject": "Re: ${full_email.subject}",
          "body_text": "Hi ${full_email.from.name},\n\nThank you for contacting support. We've flagged your issue as urgent and our team will respond within 2 hours.\n\nTicket #: ${urgent_ticket.id}\nCategory: ${classification.category}\n\nWe appreciate your patience.\n\nBest regards,\nSupport Team",
          "thread_id": "${full_email.thread_id}"
        },
        "out": "urgent_draft"
      },
      {
        "id": "mark_urgent_processed",
        "type": "tool",
        "tool": "gmail_modify_message_labels",
        "in": {
          "message_id": "${email_id}",
          "add_label_ids": ["URGENT_PROCESSED"],
          "remove_label_ids": ["UNREAD"]
        },
        "out": "urgent_label_result"
      },
      {
        "id": "check_if_auto_respond",
        "type": "if",
        "condition": "${classification.auto_response_capable == true}"
      },
      {
        "id": "generate_auto_response",
        "type": "llm",
        "model": "gpt-5",
        "temperature": 0.7,
        "prompt": "Generate a helpful, professional auto-response for this support email:\n\nFrom: ${full_email.from.email}\nName: ${full_email.from.name}\nSubject: ${full_email.subject}\nBody: ${full_email.body}\nCategory: ${classification.category}\nSentiment: ${classification.sentiment}\n\nProvide a complete, accurate response that addresses their question. Include relevant links or instructions if needed. Be empathetic and professional.",
        "out": "auto_response_data",
        "output": {
          "mode": "json",
          "schema": {
            "json_schema": {
              "type": "object",
              "properties": {
                "response_body": {
                  "type": "string"
                },
                "confidence": {
                  "type": "string",
                  "enum": ["high", "medium"]
                }
              },
              "required": ["response_body", "confidence"]
            }
          }
        }
      },
      {
        "id": "send_auto_response",
        "type": "tool",
        "tool": "gmail_send_email",
        "in": {
          "to": ["${full_email.from.email}"],
          "subject": "Re: ${full_email.subject}",
          "body_text": "${auto_response_data.response_body}",
          "thread_id": "${full_email.thread_id}"
        },
        "out": "auto_response_result"
      },
      {
        "id": "log_auto_response",
        "type": "tool",
        "tool": "supabase_table_insert",
        "in": {
          "integration_resource_id": 123,
          "table": "support_interactions",
          "record": {
            "email_id": "${email_id}",
            "thread_id": "${full_email.thread_id}",
            "customer_email": "${full_email.from.email}",
            "category": "${classification.category}",
            "interaction_type": "auto_response",
            "response_body": "${auto_response_data.response_body}"
          }
        },
        "out": "auto_response_log"
      },
      {
        "id": "mark_auto_responded",
        "type": "tool",
        "tool": "gmail_modify_message_labels",
        "in": {
          "message_id": "${email_id}",
          "add_label_ids": ["AUTO_RESPONDED"],
          "remove_label_ids": ["UNREAD"]
        },
        "out": "auto_response_label_result"
      },
      {
        "id": "create_review_ticket",
        "type": "tool",
        "tool": "supabase_table_insert",
        "in": {
          "integration_resource_id": 123,
          "table": "support_tickets",
          "record": {
            "email_id": "${email_id}",
            "thread_id": "${full_email.thread_id}",
            "customer_email": "${full_email.from.email}",
            "customer_name": "${full_email.from.name}",
            "subject": "${full_email.subject}",
            "category": "${classification.category}",
            "sentiment": "${classification.sentiment}",
            "urgency": "normal",
            "status": "needs_review",
            "priority": "normal",
            "body": "${full_email.body}",
            "classification_reasoning": "${classification.reasoning}"
          }
        },
        "out": "review_ticket"
      },
      {
        "id": "create_review_draft",
        "type": "tool",
        "tool": "gmail_create_draft",
        "in": {
          "to": ["${full_email.from.email}"],
          "subject": "Re: ${full_email.subject}",
          "body_text": "Hi ${full_email.from.name},\n\nThank you for your message. Our team is reviewing your ${classification.category} question and will provide a detailed response shortly.\n\nTicket #: ${review_ticket.id}\n\nBest regards,\nSupport Team",
          "thread_id": "${full_email.thread_id}"
        },
        "out": "review_draft"
      },
      {
        "id": "mark_needs_review",
        "type": "tool",
        "tool": "gmail_modify_message_labels",
        "in": {
          "message_id": "${email_id}",
          "add_label_ids": ["NEEDS_REVIEW"],
          "remove_label_ids": ["UNREAD"]
        },
        "out": "review_label_result"
      }
    ],
    "edges": [
      {
        "id": "e1",
        "source": "extract_email_id",
        "target": "fetch_full_email",
        "type": "default"
      },
      {
        "id": "e2",
        "source": "fetch_full_email",
        "target": "classify_email",
        "type": "default"
      },
      {
        "id": "e3",
        "source": "classify_email",
        "target": "check_if_urgent",
        "type": "default"
      },
      {
        "id": "e4_urgent_true",
        "source": "check_if_urgent",
        "target": "create_urgent_ticket",
        "type": "conditional_true"
      },
      {
        "id": "e5_urgent",
        "source": "create_urgent_ticket",
        "target": "create_urgent_draft",
        "type": "default"
      },
      {
        "id": "e6_urgent",
        "source": "create_urgent_draft",
        "target": "mark_urgent_processed",
        "type": "default"
      },
      {
        "id": "e4_urgent_false",
        "source": "check_if_urgent",
        "target": "check_if_auto_respond",
        "type": "conditional_false"
      },
      {
        "id": "e7_auto_true",
        "source": "check_if_auto_respond",
        "target": "generate_auto_response",
        "type": "conditional_true"
      },
      {
        "id": "e8_auto",
        "source": "generate_auto_response",
        "target": "send_auto_response",
        "type": "default"
      },
      {
        "id": "e9_auto",
        "source": "send_auto_response",
        "target": "log_auto_response",
        "type": "default"
      },
      {
        "id": "e10_auto",
        "source": "log_auto_response",
        "target": "mark_auto_responded",
        "type": "default"
      },
      {
        "id": "e7_auto_false",
        "source": "check_if_auto_respond",
        "target": "create_review_ticket",
        "type": "conditional_false"
      },
      {
        "id": "e11_review",
        "source": "create_review_ticket",
        "target": "create_review_draft",
        "type": "default"
      },
      {
        "id": "e12_review",
        "source": "create_review_draft",
        "target": "mark_needs_review",
        "type": "default"
      }
    ],
    "meta": {
      "description": "Automated support email triage with AI classification, conditional routing, and multi-stage processing"
    }
  }
}
