{
  "name": "LLM + Tool Workflow - Email Summary",
  "description": "Search Gmail, summarize with LLM, send draft - tests mixed node types",
  "tags": ["gmail", "llm", "ai", "summary", "draft"],
  "customization_guide": "Tests RLM ability to discover tools + LLM nodes in AI-enhanced workflows.",
  "queries": [
    "summarize my recent emails with AI and create draft reply",
    "use GPT to analyze Gmail messages and prepare response",
    "get emails, generate AI summary, make draft"
  ],
  "expected_tools": ["gmail_read_emails", "gmail_create_draft"],
  "spec": {
    "version": "2",
    "nodes": [
      {
        "id": "search_emails",
        "type": "tool",
        "tool": "gmail_read_emails",
        "in": {
          "q": "important",
          "max_results": 5
        },
        "out": "emails"
      },
      {
        "id": "summarize",
        "type": "llm",
        "model": "gpt-5-mini",
        "prompt": "Summarize these emails concisely:\n${emails}",
        "out": "summary",
        "output": {
          "mode": "json",
          "schema": {
            "json_schema": {
              "type": "object",
              "properties": {
                "summary": {"type": "string"},
                "key_points": {"type": "array", "items": {"type": "string"}}
              },
              "required": ["summary"]
            }
          }
        }
      },
      {
        "id": "create_draft",
        "type": "tool",
        "tool": "gmail_create_draft",
        "in": {
          "to": ["team@example.com"],
          "subject": "Email Summary",
          "body_text": "${summary.summary}"
        },
        "out": "draft_result"
      }
    ],
    "edges": [
      {
        "id": "e1",
        "source": "search_emails",
        "target": "summarize",
        "type": "default"
      },
      {
        "id": "e2",
        "source": "summarize",
        "target": "create_draft",
        "type": "default"
      }
    ]
  }
}
