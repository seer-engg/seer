{
  "mcpServers": {
    "seer": {
      "command": "uv",
      "args": ["run", "--directory", "/home/lokesh/second/seer", "seer-mcp", "--transport", "stdio"]
    },
    "langfuse": {
      "command": "uvx",
      "args": ["--python", "3.11", "langfuse-mcp"],
      "env": {
        "LANGFUSE_PUBLIC_KEY": "YOUR_PUBLIC_KEY",
        "LANGFUSE_SECRET_KEY": "YOUR_SECRET_KEY",
        "LANGFUSE_HOST": "https://tracing.getseer.dev"
      }
    },
    "metabase-mcp": {
        "command": "uvx",
        "args": ["metabase-mcp"],
        "env": {
            "METABASE_URL": "https://metabase.getseer.dev",
            "METABASE_API_KEY": "${METABASE_API_KEY}"
        }
    }
  }
}
