# E2E Test Credentials
# Copy this file to .env.test and fill in real credentials
#
# These should be credentials for a test user account in Clerk
# The test user should have:
# - Completed onboarding
# - Payment method added (if required by your app)

E2E_CLERK_EMAIL=your-test-email@example.com
E2E_CLERK_PASSWORD=your-test-password

# Backend API URL for workflow API calls (test isolation)
# Default: http://localhost:8000
VITE_BACKEND_API_URL=http://localhost:8000
