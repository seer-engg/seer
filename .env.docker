# Docker-specific environment configuration
# These values are for containers only - use .env.thread for local development

# Container service URLs (use Docker service hostnames, not localhost)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/seer
REDIS_URL=redis://redis:6379/0

# Frontend integration - uses cloud frontend by default
FRONTEND_URL=https://app.getseer.dev
BACKEND_API_URL=localhost:8000
AUTO_OPEN_BROWSER=true

# Enable chat AI in self-hosted mode (-1 = unlimited, 0 = disabled)
CHAT_MESSAGES_TOTAL_SELF_HOSTED=-1

# Python configuration
PYTHONUNBUFFERED=1

# Thread identification
THREAD_ID=2
THREAD_BRANCH=thread-2-nexus-testing

# API Keys - Set these in .env.thread or pass via docker-compose environment
# GITHUB_TOKEN=your_github_token_here
# OPENAI_API_KEY=your_openai_key_here
